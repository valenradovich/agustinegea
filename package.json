{
  "name": "agustinegea",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "node scripts/git-hooks.mjs install",
    "dev": "node scripts/git-hooks.mjs install && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm build",
    "hooks:enable": "node scripts/git-hooks.mjs enable",
    "hooks:disable": "node scripts/git-hooks.mjs disable",
    "test:hooks": "node --test scripts/git-hooks.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "next": "16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3"
  },
  "description": "The shared Agustin Egea parody website, improved through community pull requests.",
  "license": "MIT",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": "24.x",
    "pnpm": "10.x"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/valenradovich/agustinegea.git"
  }
}
